rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // RESUMES:
    // - Candidates can upload (create) resume files (max size 10MB)
    // - Public or admins with direct download URL can view/download
    // - Only authenticated admins can delete resumes
    match /resumes/{allPaths=**} {
      allow create: if request.resource.size < 10 * 1024 * 1024;
      allow read: if true;
      allow delete: if isAuthenticated();
    }

    // Default rule for all other assets
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
